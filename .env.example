# PostgreSQL connection string (local or hosted, e.g. Aiven)
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL="postgresql://quizzy:quizzy@localhost:5432/quizzy?schema=public"

# Iron-session secret (must be 32+ chars)
SESSION_SECRET="quizzy-session-secret-must-be-32-chars!!"

# Piston code execution API (optional; only needed for CODING questions)
PISTON_URL=http://localhost:2000

# Server config — PORT is read from this file by server.js
PORT=3000

# Do not set NODE_ENV here. Use:
#   pnpm dev   → development
#   pnpm start → production (after pnpm build)
